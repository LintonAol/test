{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "HackerNewsBestStories": "Information"
    }
  },
  "AllowedHosts": "*",
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "MaxConcurrentRequests": 10,
    "MaxStoryCount": 200,
    "BestStoryIdsCacheDuration": "00:01:00",
    "StoryCacheDuration": "00:05:00"
  }
}
